"""Root BUILD.bazel — alpha-research-2026 monorepo.

All Bazel run targets are gated through scripts/runner.py which dispatches
to the appropriate sub-action (backtest, notebook, docker_build, etc.).

Targets:
    //:backtest        — Run full signal backtest across all strategies
    //:research        — Launch Jupyter research notebook
    //:docker_build    — Build Docker image
    //:docker_research — Launch notebook inside Docker
    //:docker_down     — Tear down Docker compose stack
    //:test_all        — Run all C++ and Python tests

Author: Alpha Research Pod — 2026
"""

load("@rules_python//python:defs.bzl", "py_binary", "py_library")

# ── alpha_cpp.so at workspace root — required for `import alpha_cpp` ─────────
#
# WHY THIS GENRULE EXISTS
# ───────────────────────
# src/python/alpha_research/BUILD.bazel has `imports = ["../../.."]`, which
# adds the workspace root (runfiles __main__/) to sys.path for every py_binary
# that depends on //src/python:alpha_research.
#
# The nanobind extension produced by //src/cpp:alpha_cpp.so lives at
#   bazel-bin/src/cpp/alpha_cpp.so  →  runfiles __main__/src/cpp/alpha_cpp.so
#
# That path is NOT on sys.path, so `import alpha_cpp` fails.
# This genrule copies it to bazel-bin/alpha_cpp.so →  runfiles __main__/alpha_cpp.so
# which IS on sys.path.  Zero code changes to any Python source needed.
genrule(
    name = "alpha_cpp_so",
    srcs = ["//src/cpp:alpha_cpp.so"],
    outs = ["alpha_cpp.so"],
    cmd = "cp $< $@",
    visibility = ["//visibility:public"],
)

# ── Backtest runner ──────────────────────────────────────────────────────────
py_binary(
    name = "backtest",
    srcs = ["scripts/runner.py"],
    args = ["backtest"],
    main = "scripts/runner.py",
    deps = [
        "//src/python:alpha_research",
    ],
    visibility = ["//visibility:public"],
)

# ── Research notebook launcher ───────────────────────────────────────────────
py_binary(
    name = "research",
    srcs = ["scripts/runner.py"],
    args = ["jupyter"],
    main = "scripts/runner.py",
    deps = [
        "//src/python:alpha_research",
    ],
    visibility = ["//visibility:public"],
)

# ── Signal monitor (decay detection + alerting) ──────────────────────────────
py_binary(
    name = "monitor",
    srcs = ["scripts/runner.py"],
    args = ["monitor"],
    main = "scripts/runner.py",
    deps = [
        "//src/python:alpha_research",
    ],
    visibility = ["//visibility:public"],
)

# ── Docker targets ───────────────────────────────────────────────────────────
py_binary(
    name = "docker_build",
    srcs = ["scripts/runner.py"],
    args = ["docker_build"],
    main = "scripts/runner.py",
    visibility = ["//visibility:public"],
)

py_binary(
    name = "docker_research",
    srcs = ["scripts/runner.py"],
    args = ["docker_jupyter"],
    main = "scripts/runner.py",
    visibility = ["//visibility:public"],
)

py_binary(
    name = "docker_down",
    srcs = ["scripts/runner.py"],
    args = ["docker_down"],
    main = "scripts/runner.py",
    visibility = ["//visibility:public"],
)

# ── Aggregate test target ────────────────────────────────────────────────────
# Run via: bazel test //:test_all
test_suite(
    name = "test_all",
    tests = [
        "//tests/cpp:all_cpp_tests",
        "//tests/python:all_python_tests",
    ],
)
